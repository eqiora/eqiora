public component QuadraticPatch(support body: volume(ambient_dimension=2),support x_lower: boundary(parent=body),support x_upper: boundary(parent=body),support y_lower: boundary(parent=body),support y_upper: boundary(parent=body)) {
variable u: 1 on body in smooth;
relation balance on body { -div(grad(u))=-(2/4[m^2]*(1+(coordinate(1)/3[m])^2)+2/9[m^2]*(1+(coordinate(0)/2[m])^2)); }
relation flux_x_lower on x_lower { normal(grad(u))=0[1/m]; }
relation essential on x_upper { trace(u)=(1+(coordinate(0)/2[m])^2)*(1+(coordinate(1)/3[m])^2); }
relation flux_y_lower on y_lower { normal(grad(u))=0[1/m]; }
relation flux_y_upper on y_upper { normal(grad(u))=2/3[m]*(1+(coordinate(0)/2[m])^2); }
}
