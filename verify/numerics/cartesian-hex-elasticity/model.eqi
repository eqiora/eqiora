// Cartesian Q1 patch; independent mathematics lives in reference/.
public component CartesianHexElasticity(
  support body: volume(ambient_dimension=3),
  support x_lower: boundary(parent=body),
  support x_upper: boundary(parent=body),
  support y_lower: boundary(parent=body),
  support y_upper: boundary(parent=body),
  support z_lower: boundary(parent=body),
  support z_upper: boundary(parent=body),
  parameter mu: Pa,
  parameter lambda: Pa
) {
  parameter a0: vector<1,3> = tensor_value(frame=body,components=[1,0,1]);
  parameter a1: vector<1,3> = tensor_value(frame=body,components=[2,3,0]);
  parameter a2: vector<1,3> = tensor_value(frame=body,components=[0,1,2]);
  parameter tx: vector<Pa,3> = tensor_value(frame=body,components=[1.125,0.375,0.1875]);
  parameter ty: vector<Pa,3> = tensor_value(frame=body,components=[0.375,1.875,0.1875]);
  parameter tz: vector<Pa,3> = tensor_value(frame=body,components=[0.1875,0.1875,1.5]);
  variable displacement: vector<m,3> on body in h1;
  relation balance on body { -div((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement))))=0; }
  relation fixed on x_lower {
    trace(displacement)=(a0*coordinate(0)+a1*coordinate(1)+a2*coordinate(2))/16;
  }
  relation natural_x_upper on x_upper { normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement))))=tx; }
  relation natural_y_lower on y_lower { normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement))))=-ty; }
  relation natural_y_upper on y_upper { normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement))))=ty; }
  relation natural_z_lower on z_lower { normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement))))=-tz; }
  relation natural_z_upper on z_upper { normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement))))=tz; }
  observable energy: J = integral(
    mu*contract(symmetric_part(grad(displacement)),symmetric_part(grad(displacement)),axes=((0,0),(1,1)))
    +lambda*div(displacement)*div(displacement)/2, measure(body));
  observable left_x: N = integral(component(normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement)))),indices=(0,)),measure(x_lower));
  observable left_y: N = integral(component(normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement)))),indices=(1,)),measure(x_lower));
  observable left_z: N = integral(component(normal((2*mu*symmetric_part(grad(displacement)) + lambda*isotropic_lift(div(displacement)))),indices=(2,)),measure(x_lower));
  form weak for balance {
    test w: m for displacement zero_on x_lower;
    integrate(body,2*mu*frobenius(symmetric_part(grad(w)),symmetric_part(grad(displacement))) + lambda*div(w)*div(displacement)) =
      integrate(x_upper,dot(trace(w),tx))
      +integrate(y_lower,dot(trace(w),-ty))
      +integrate(y_upper,dot(trace(w),ty))
      +integrate(z_lower,dot(trace(w),-tz))
      +integrate(z_upper,dot(trace(w),tz));
  }
}
