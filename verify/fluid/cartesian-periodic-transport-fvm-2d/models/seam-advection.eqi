public connector ScalarTransportBoundary {
  trace concentration: K;
  flux transport_flux: K * m / s;
  shape [];
  frame invariant;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public component PeriodicTransportSide2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable concentration: K on body in smooth,
  variable flow_potential: m ^ 2 / s on body in smooth,
  parameter diffusivity: m ^ 2 / s,
  port transport: ScalarTransportBoundary over face
) {
  relation periodic_binding on face {
    trace(concentration) - transport.concentration = 0;
    normal(
      concentration * grad(flow_potential)
      - diffusivity * grad(concentration)
    ) - transport.transport_flux = 0;
  }
}

model Main() {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);
  state concentration: K on body in smooth;
  initial { concentration = 1[K]; }
  variable flow_potential: m ^ 2 / s on body in smooth;
  parameter speed: m / s = 1;
  parameter diffusivity: m ^ 2 / s = 0.2;
  relation flow_definition on body {
    flow_potential - speed * coordinate(0) = 0;
  }
  relation transport on body {
    derivative(concentration)
      + div(concentration * grad(flow_potential))
      - div(diffusivity * grad(concentration)) = 0;
  }
  instance x_lower_periodic: PeriodicTransportSide2d(
    body = body,
    face = x_lower,
    concentration = concentration,
    flow_potential = flow_potential,
    diffusivity = diffusivity
  );
  instance x_upper_periodic: PeriodicTransportSide2d(
    body = body,
    face = x_upper,
    concentration = concentration,
    flow_potential = flow_potential,
    diffusivity = diffusivity
  );
  relation y_lower_flux on y_lower {
    normal(diffusivity * grad(concentration)) = 0;
  }
  relation y_upper_flux on y_upper {
    normal(diffusivity * grad(concentration)) = 0;
  }
  connect periodic x_lower_periodic.transport, x_upper_periodic.transport;
}
