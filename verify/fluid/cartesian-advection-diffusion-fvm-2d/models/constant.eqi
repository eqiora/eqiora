model Main() {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  state concentration: K on body in smooth;
  initial { concentration = 1[K]; }
  variable flow_potential: m ^ 2 / s on body;
  parameter speed: m / s = 1;
  parameter diffusivity: m ^ 2 / s = 0.2;
  parameter inflow: K = 1;

  relation flow_definition on body {
    flow_potential - speed * coordinate(0) = 0;
  }
  relation transport on body {
    derivative(concentration)
      + div(concentration * grad(flow_potential))
      - div(diffusivity * grad(concentration)) = 0;
  }

  relation x_lower_value on x_lower {
    trace(concentration) - inflow = 0;
  }
  relation x_upper_flux on x_upper {
    normal(diffusivity * grad(concentration)) = 0;
  }
  relation y_lower_flux on y_lower {
    normal(diffusivity * grad(concentration)) = 0;
  }
  relation y_upper_flux on y_upper {
    normal(diffusivity * grad(concentration)) = 0;
  }
}
