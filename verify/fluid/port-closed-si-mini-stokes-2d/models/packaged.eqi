model Main() {
  domain body = box(0, 4, 0, 2);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  variable velocity: vector<m / s, 2> on body in smooth;
  variable pressure: kg / (m * s ^ 2) on body in h1;
  variable force_potential: kg / (m * s ^ 2) on body;
  parameter dynamic_viscosity: kg / (m * s) = 6;
  parameter force_gradient: kg / (m ^ 2 * s ^ 2) = 0.75;
  parameter pressure_zero_coordinate: m = 2;

  relation force_definition on body {
    force_potential
      - force_gradient * (coordinate(0) - pressure_zero_coordinate) = 0;
  }
  instance law: fluid.SteadyStokesWithPotential2d(
    body = body,
    velocity = velocity,
    pressure = pressure,
    force_potential = force_potential,
    dynamic_viscosity = dynamic_viscosity
  );
  instance boundary: fluid.NewtonianMechanicalInterface2d(
    body = body,
    exterior = boundaries(x_lower, x_upper, y_lower, y_upper),
    velocity = velocity,
    pressure = pressure,
    dynamic_viscosity = dynamic_viscosity
  );

  instance x_lower_zero: mechanics.ZeroVelocity2d(
    body = body, face = x_lower
  );
  instance x_upper_zero: mechanics.ZeroVelocity2d(
    body = body, face = x_upper
  );
  instance y_lower_zero: mechanics.ZeroVelocity2d(
    body = body, face = y_lower
  );
  instance y_upper_zero: mechanics.ZeroVelocity2d(
    body = body, face = y_upper
  );

  connect boundary.mechanical[boundary = x_lower], x_lower_zero.mechanical;
  connect boundary.mechanical[boundary = x_upper], x_upper_zero.mechanical;
  connect boundary.mechanical[boundary = y_lower], y_lower_zero.mechanical;
  connect boundary.mechanical[boundary = y_upper], y_upper_zero.mechanical;
}
