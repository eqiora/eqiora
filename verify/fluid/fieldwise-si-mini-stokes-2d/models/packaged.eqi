model Main() {
  domain body = box(0, 4, 0, 2);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  variable velocity: vector<m / s, 2> on body in h1;
  variable pressure: kg / (m * s ^ 2) on body;
  variable force_potential: kg / (m * s ^ 2) on body;
  parameter force_gradient: kg / (m ^ 2 * s ^ 2) = 0.75;
  parameter pressure_zero_coordinate: m = 2;

  relation force_definition on body {
    force_potential
      - force_gradient * (coordinate(0) - pressure_zero_coordinate) = 0;
  }
  instance fluid_law: fluid.SteadyStokesWithPotential2d(
    body = body,
    velocity = velocity,
    pressure = pressure,
    force_potential = force_potential,
    dynamic_viscosity = 6[kg / (m * s)]
  );

  relation x_lower_value on x_lower { trace(velocity) = 0; }
  relation x_upper_value on x_upper { trace(velocity) = 0; }
  relation y_lower_value on y_lower { trace(velocity) = 0; }
  relation y_upper_value on y_upper { trace(velocity) = 0; }
}
