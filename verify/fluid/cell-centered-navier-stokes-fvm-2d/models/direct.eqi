public operator outer_product(input left: spatial[1], input right: spatial[1]): spatial[2]
  = component(left, 0) * component(right, 1);

model Main() {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  state velocity: vector<m / s, 2> on body in h1;
  variable pressure: kg / (m * s ^ 2) on body;
  variable force_potential: kg / (m * s ^ 2) on body;
  parameter density: kg / m ^ 3 = 1;
  parameter dynamic_viscosity: kg / (m * s) = 0.05;
  parameter zero_pressure: kg / (m * s ^ 2) = 0;

  relation force_definition on body {
    force_potential - zero_pressure = 0;
  }
  relation momentum on body {
    density * derivative(velocity)
      + div(density * outer_product(left = velocity, right = velocity))
      - div(
        2 * dynamic_viscosity * symmetric_part(grad(velocity))
        - isotropic_lift(pressure)
      ) - grad(force_potential) = 0;
  }
  relation incompressibility on body {
    div(velocity) = 0;
  }

  relation x_lower_value on x_lower { trace(velocity) = 0; }
  relation x_upper_value on x_upper { trace(velocity) = 0; }
  relation y_lower_value on y_lower { trace(velocity) = 0; }
  relation y_upper_value on y_upper { trace(velocity) = 0; }
}
