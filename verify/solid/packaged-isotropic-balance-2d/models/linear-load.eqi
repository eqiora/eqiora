model Main() {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  variable displacement: vector<m, 2> on body in h1;
  variable load_potential: kg / (m * s ^ 2) on body;
  parameter mu: kg / (m * s ^ 2) = 3;
  parameter lambda: kg / (m * s ^ 2) = 2;
  parameter pressure_gradient: kg / (m ^ 2 * s ^ 2) = 1;

  relation load on body {
    load_potential - pressure_gradient * coordinate(0) = 0;
  }
  instance balance_law: solid.IsotropicBalanceWithPotential2d(
    body = body,
    displacement = displacement,
    load_potential = load_potential,
    mu = mu,
    lambda = lambda
  );

  relation x_lower_value on x_lower { trace(displacement) = 0; }
  relation x_upper_value on x_upper { trace(displacement) = 0; }
  relation y_lower_value on y_lower { trace(displacement) = 0; }
  relation y_upper_value on y_upper { trace(displacement) = 0; }
}
