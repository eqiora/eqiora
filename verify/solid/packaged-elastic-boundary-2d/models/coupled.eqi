public component BoundaryTerminal(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: solid.QuasistaticMechanicalBoundary over face
) {
  relation free_traction on face {
    mechanical.traction = 0;
  }
}

model Main() {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);
  variable displacement: vector<m, 2> on body in smooth;
  parameter mu: kg / (m * s ^ 2) = 3;
  parameter lambda: kg / (m * s ^ 2) = 2;

  instance solid_boundary: solid.IsotropicMechanicalInterface2d(
    body = body,
    exterior = boundaries(y_upper, x_lower, y_lower, x_upper),
    displacement = displacement,
    mu = mu,
    lambda = lambda
  );
  instance x_lower_terminal: BoundaryTerminal(
    body = body,
    face = x_lower
  );
  instance x_upper_terminal: BoundaryTerminal(
    body = body,
    face = x_upper
  );
  instance y_lower_terminal: BoundaryTerminal(
    body = body,
    face = y_lower
  );
  instance y_upper_terminal: BoundaryTerminal(
    body = body,
    face = y_upper
  );

  connect solid_boundary.mechanical[boundary = x_lower],
    x_lower_terminal.mechanical;
  connect solid_boundary.mechanical[boundary = x_upper],
    x_upper_terminal.mechanical;
  connect solid_boundary.mechanical[boundary = y_lower],
    y_lower_terminal.mechanical;
  connect solid_boundary.mechanical[boundary = y_upper],
    y_upper_terminal.mechanical;
}
