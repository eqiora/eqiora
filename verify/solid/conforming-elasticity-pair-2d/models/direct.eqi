public connector QuasistaticMechanicalBoundary {
  trace displacement: m;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public component IsotropicMechanicalInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  parameter mu: kg / (m * s ^ 2),
  parameter lambda: kg / (m * s ^ 2),
  port mechanical[boundary in exterior]: QuasistaticMechanicalBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(displacement)
      - mechanical[boundary = boundary].displacement = 0;
    normal(
      2 * mu * symmetric_part(grad(displacement))
      + lambda * isotropic_lift(div(displacement))
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

public component FixedDisplacement2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: QuasistaticMechanicalBoundary over face
) {
  relation prescribed_displacement on face {
    mechanical.displacement = 0;
  }
}

public component ZeroTraction2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: QuasistaticMechanicalBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction = 0;
  }
}

model Main() {
  domain left = box(0, 0.5, 0, 1);
  domain left_x_lower = boundary(left, axis = 0, side = lower);
  domain left_x_upper = boundary(left, axis = 0, side = upper);
  domain left_y_lower = boundary(left, axis = 1, side = lower);
  domain left_y_upper = boundary(left, axis = 1, side = upper);
  domain right = box(0.5, 1, 0, 1);
  domain right_x_lower = boundary(right, axis = 0, side = lower);
  domain right_x_upper = boundary(right, axis = 0, side = upper);
  domain right_y_lower = boundary(right, axis = 1, side = lower);
  domain right_y_upper = boundary(right, axis = 1, side = upper);

  variable left_displacement: vector<m, 2> on left in smooth;
  variable left_load_potential: kg / (m * s ^ 2) on left;
  variable right_displacement: vector<m, 2> on right in smooth;
  variable right_load_potential: kg / (m * s ^ 2) on right;
  parameter mu_left: kg / (m * s ^ 2) = 3;
  parameter mu_right: kg / (m * s ^ 2) = 6;
  parameter lambda: kg / (m * s ^ 2) = 0;
  parameter length_scale: m = 1;

  relation left_load on left {
    left_load_potential
      - 2 * mu_left * coordinate(0) / length_scale = 0;
  }
  relation left_balance on left {
    -div(
      2 * mu_left * symmetric_part(grad(left_displacement))
      + lambda * isotropic_lift(div(left_displacement))
    ) - grad(left_load_potential) = 0;
  }
  relation right_load on right {
    right_load_potential
      - mu_right * coordinate(0) / length_scale = 0;
  }
  relation right_balance on right {
    -div(
      2 * mu_right * symmetric_part(grad(right_displacement))
      + lambda * isotropic_lift(div(right_displacement))
    ) - grad(right_load_potential) = 0;
  }

  instance left_boundary: IsotropicMechanicalInterface2d(
    body = left,
    exterior = boundaries(
      left_x_lower,
      left_x_upper,
      left_y_lower,
      left_y_upper
    ),
    displacement = left_displacement,
    mu = mu_left,
    lambda = lambda
  );
  instance right_boundary: IsotropicMechanicalInterface2d(
    body = right,
    exterior = boundaries(
      right_x_lower,
      right_x_upper,
      right_y_lower,
      right_y_upper
    ),
    displacement = right_displacement,
    mu = mu_right,
    lambda = lambda
  );
  instance fixed: FixedDisplacement2d(
    body = left,
    face = left_x_lower
  );
  instance left_y_lower_free: ZeroTraction2d(
    body = left,
    face = left_y_lower
  );
  instance left_y_upper_free: ZeroTraction2d(
    body = left,
    face = left_y_upper
  );
  instance right_x_upper_free: ZeroTraction2d(
    body = right,
    face = right_x_upper
  );
  instance right_y_lower_free: ZeroTraction2d(
    body = right,
    face = right_y_lower
  );
  instance right_y_upper_free: ZeroTraction2d(
    body = right,
    face = right_y_upper
  );

  connect left_boundary.mechanical[boundary = left_x_lower],
    fixed.mechanical;
  connect left_boundary.mechanical[boundary = left_y_lower],
    left_y_lower_free.mechanical;
  connect left_boundary.mechanical[boundary = left_y_upper],
    left_y_upper_free.mechanical;
  connect right_boundary.mechanical[boundary = right_x_upper],
    right_x_upper_free.mechanical;
  connect right_boundary.mechanical[boundary = right_y_lower],
    right_y_lower_free.mechanical;
  connect right_boundary.mechanical[boundary = right_y_upper],
    right_y_upper_free.mechanical;
  connect left_boundary.mechanical[boundary = left_x_upper],
    right_boundary.mechanical[boundary = right_x_lower];
}
