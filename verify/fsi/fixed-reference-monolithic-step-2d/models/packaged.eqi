model Main() {
  domain fluid_domain = box(0, 1, 0, 1);
  domain fluid_x_lower = boundary(fluid_domain, axis = 0, side = lower);
  domain fluid_x_upper = boundary(fluid_domain, axis = 0, side = upper);
  domain fluid_y_lower = boundary(fluid_domain, axis = 1, side = lower);
  domain fluid_y_upper = boundary(fluid_domain, axis = 1, side = upper);

  domain solid_domain = box(1, 2, 0, 1);
  domain solid_x_lower = boundary(solid_domain, axis = 0, side = lower);
  domain solid_x_upper = boundary(solid_domain, axis = 0, side = upper);
  domain solid_y_lower = boundary(solid_domain, axis = 1, side = lower);
  domain solid_y_upper = boundary(solid_domain, axis = 1, side = upper);

  state fluid_velocity: vector<m / s, 2> on fluid_domain in smooth;
  variable fluid_pressure: kg / (m * s ^ 2) on fluid_domain in h1;
  variable fluid_load_potential: kg / (m * s ^ 2) on fluid_domain;
  parameter fluid_zero_pressure: kg / (m * s ^ 2) = 0;
  relation fluid_load_definition on fluid_domain {
    fluid_load_potential - fluid_zero_pressure = 0;
  }
  instance fluid_law: inertial.InertialStokesWithPotential2d(
    body = fluid_domain,
    velocity = fluid_velocity,
    pressure = fluid_pressure,
    force_potential = fluid_load_potential,
    density = 2[kg / m^3],
    dynamic_viscosity = 0.5[kg / (m * s)]
  );
  instance fluid_boundary: fluid.NewtonianMechanicalInterface2d(
    body = fluid_domain,
    exterior = boundaries(
      fluid_x_lower, fluid_x_upper, fluid_y_lower, fluid_y_upper
    ),
    velocity = fluid_velocity,
    pressure = fluid_pressure,
    dynamic_viscosity = 0.5[kg / (m * s)]
  );

  state solid_displacement: vector<m, 2> on solid_domain in smooth;
  state solid_velocity: vector<m / s, 2> on solid_domain in h1;
  variable solid_load_potential: kg / (m * s ^ 2) on solid_domain;
  parameter solid_zero_pressure: kg / (m * s ^ 2) = 0;
  relation solid_load_definition on solid_domain {
    solid_load_potential - solid_zero_pressure = 0;
  }
  instance solid_law: solid.IsotropicElastodynamicsWithPotential2d(
    body = solid_domain,
    displacement = solid_displacement,
    velocity = solid_velocity,
    load_potential = solid_load_potential,
    density = 3[kg / m^3],
    mu = 4[Pa],
    lambda = 2[Pa]
  );
  instance solid_boundary: solid.ElastodynamicMechanicalInterface2d(
    body = solid_domain,
    exterior = boundaries(
      solid_x_lower, solid_x_upper, solid_y_lower, solid_y_upper
    ),
    displacement = solid_displacement,
    velocity = solid_velocity,
    mu = 4[Pa],
    lambda = 2[Pa]
  );

  instance fluid_x_lower_zero: mechanics.ZeroVelocity2d(
    body = fluid_domain, face = fluid_x_lower
  );
  instance fluid_y_lower_zero: mechanics.ZeroVelocity2d(
    body = fluid_domain, face = fluid_y_lower
  );
  instance fluid_y_upper_zero: mechanics.ZeroVelocity2d(
    body = fluid_domain, face = fluid_y_upper
  );
  instance solid_x_upper_zero: mechanics.ZeroVelocity2d(
    body = solid_domain, face = solid_x_upper
  );
  instance solid_y_lower_zero: mechanics.ZeroVelocity2d(
    body = solid_domain, face = solid_y_lower
  );
  instance solid_y_upper_zero: mechanics.ZeroVelocity2d(
    body = solid_domain, face = solid_y_upper
  );

  connect fluid_boundary.mechanical[boundary = fluid_x_lower],
    fluid_x_lower_zero.mechanical;
  connect fluid_boundary.mechanical[boundary = fluid_y_lower],
    fluid_y_lower_zero.mechanical;
  connect fluid_boundary.mechanical[boundary = fluid_y_upper],
    fluid_y_upper_zero.mechanical;
  connect solid_boundary.mechanical[boundary = solid_x_upper],
    solid_x_upper_zero.mechanical;
  connect solid_boundary.mechanical[boundary = solid_y_lower],
    solid_y_lower_zero.mechanical;
  connect solid_boundary.mechanical[boundary = solid_y_upper],
    solid_y_upper_zero.mechanical;
  connect fluid_boundary.mechanical[boundary = fluid_x_upper],
    solid_boundary.mechanical[boundary = solid_x_lower];
}
