public operator outer_product(input left: spatial[1], input right: spatial[1]): spatial[2]
  = component(left, 0) * component(right, 1);

public connector VelocityTractionBoundary {
  trace velocity: m / s;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public component ZeroVelocity2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: VelocityTractionBoundary over face
) {
  relation prescribed_velocity on face {
    mechanical.velocity = 0;
  }
}

public component NewtonianMechanicalInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable velocity: vector<m / s, 2> on body in smooth,
  variable pressure: kg / (m * s ^ 2) on body in h1,
  parameter dynamic_viscosity: kg / (m * s),
  port mechanical[boundary in exterior]: VelocityTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(velocity)
      - mechanical[boundary = boundary].velocity = 0;
    normal(
      2 * dynamic_viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

public component ElastodynamicMechanicalInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  variable velocity: vector<m / s, 2> on body in h1,
  parameter mu: kg / (m * s ^ 2),
  parameter lambda: kg / (m * s ^ 2),
  port mechanical[boundary in exterior]: VelocityTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(velocity)
      - mechanical[boundary = boundary].velocity = 0;
    normal(
      2 * mu * symmetric_part(grad(displacement))
      + lambda * isotropic_lift(div(displacement))
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

model Main() {
  domain fluid = box(0, 1, 0, 1);
  domain fluid_x_lower = boundary(fluid, axis = 0, side = lower);
  domain fluid_x_upper = boundary(fluid, axis = 0, side = upper);
  domain fluid_y_lower = boundary(fluid, axis = 1, side = lower);
  domain fluid_y_upper = boundary(fluid, axis = 1, side = upper);

  domain solid = box(1, 2, 0, 1);
  domain solid_x_lower = boundary(solid, axis = 0, side = lower);
  domain solid_x_upper = boundary(solid, axis = 0, side = upper);
  domain solid_y_lower = boundary(solid, axis = 1, side = lower);
  domain solid_y_upper = boundary(solid, axis = 1, side = upper);

  state fluid_velocity: vector<m / s, 2> on fluid in smooth;
  variable fluid_pressure: kg / (m * s ^ 2) on fluid in h1;
  variable fluid_load_potential: kg / (m * s ^ 2) on fluid;
  parameter fluid_density: kg / m ^ 3 = 1;
  parameter fluid_viscosity: kg / (m * s) = 0.2;
  parameter fluid_zero_pressure: kg / (m * s ^ 2) = 0;

  relation fluid_load_definition on fluid {
    fluid_load_potential - fluid_zero_pressure = 0;
  }
  relation fluid_momentum on fluid {
    fluid_density * derivative(fluid_velocity)
      + div(fluid_density * outer_product(left = fluid_velocity, right = fluid_velocity))
      - div(
        2 * fluid_viscosity * symmetric_part(grad(fluid_velocity))
        - isotropic_lift(fluid_pressure)
      ) - grad(fluid_load_potential) = 0;
  }
  relation incompressibility on fluid {
    div(fluid_velocity) = 0;
  }

  state solid_displacement: vector<m, 2> on solid in smooth;
  state solid_velocity: vector<m / s, 2> on solid in h1;
  variable solid_load_potential: kg / (m * s ^ 2) on solid;
  parameter solid_density: kg / m ^ 3 = 1;
  parameter solid_mu: kg / (m * s ^ 2) = 2;
  parameter solid_lambda: kg / (m * s ^ 2) = 1;
  parameter solid_zero_pressure: kg / (m * s ^ 2) = 0;

  relation solid_load_definition on solid {
    solid_load_potential - solid_zero_pressure = 0;
  }
  relation solid_kinematics on solid {
    derivative(solid_displacement) - solid_velocity = 0;
  }
  relation solid_momentum on solid {
    solid_density * derivative(solid_velocity)
      - div(
        2 * solid_mu * symmetric_part(grad(solid_displacement))
        + solid_lambda * isotropic_lift(div(solid_displacement))
      ) - grad(solid_load_potential) = 0;
  }

  instance fluid_boundary: NewtonianMechanicalInterface2d(
    body = fluid,
    exterior = boundaries(
      fluid_x_lower, fluid_x_upper, fluid_y_lower, fluid_y_upper
    ),
    velocity = fluid_velocity,
    pressure = fluid_pressure,
    dynamic_viscosity = fluid_viscosity
  );
  instance solid_boundary: ElastodynamicMechanicalInterface2d(
    body = solid,
    exterior = boundaries(
      solid_x_lower, solid_x_upper, solid_y_lower, solid_y_upper
    ),
    displacement = solid_displacement,
    velocity = solid_velocity,
    mu = solid_mu,
    lambda = solid_lambda
  );

  instance fluid_x_lower_zero: ZeroVelocity2d(
    body = fluid, face = fluid_x_lower
  );
  instance fluid_y_lower_zero: ZeroVelocity2d(
    body = fluid, face = fluid_y_lower
  );
  instance fluid_y_upper_zero: ZeroVelocity2d(
    body = fluid, face = fluid_y_upper
  );
  instance solid_x_upper_zero: ZeroVelocity2d(
    body = solid, face = solid_x_upper
  );
  instance solid_y_lower_zero: ZeroVelocity2d(
    body = solid, face = solid_y_lower
  );
  instance solid_y_upper_zero: ZeroVelocity2d(
    body = solid, face = solid_y_upper
  );

  connect fluid_boundary.mechanical[boundary = fluid_x_lower],
    fluid_x_lower_zero.mechanical;
  connect fluid_boundary.mechanical[boundary = fluid_y_lower],
    fluid_y_lower_zero.mechanical;
  connect fluid_boundary.mechanical[boundary = fluid_y_upper],
    fluid_y_upper_zero.mechanical;
  connect solid_boundary.mechanical[boundary = solid_x_upper],
    solid_x_upper_zero.mechanical;
  connect solid_boundary.mechanical[boundary = solid_y_lower],
    solid_y_lower_zero.mechanical;
  connect solid_boundary.mechanical[boundary = solid_y_upper],
    solid_y_upper_zero.mechanical;
  connect fluid_boundary.mechanical[boundary = fluid_x_upper],
    solid_boundary.mechanical[boundary = solid_x_lower];
}
