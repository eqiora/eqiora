import Eqiora.Solid.LinearElasticity.linear_elasticity as solid;

model ReferenceElasticBody() {
  domain body = box(0, 1, 0, 1);
  domain left = boundary(body, axis = 0, side = lower);
  domain right = boundary(body, axis = 0, side = upper);
  domain bottom = boundary(body, axis = 1, side = lower);
  domain top = boundary(body, axis = 1, side = upper);
  variable displacement: vector<m, 2> on body in smooth;

  parameter mu: Pa = 3;
  parameter lambda: Pa = 2;
  instance balance: solid.IsotropicBalance2d(
    body = body, displacement = displacement,
    mu = mu, lambda = lambda
  );
  instance elasticity: solid.IsotropicMechanicalInterface2d(
    body = body, exterior = boundaries(left, right, bottom, top),
    displacement = displacement, mu = mu, lambda = lambda
  );
  instance clamp: solid.FixedDisplacement2d(body = body, face = left);
  instance free_right: solid.ZeroTraction2d(body = body, face = right);
  instance free_bottom: solid.ZeroTraction2d(body = body, face = bottom);
  instance free_top: solid.ZeroTraction2d(body = body, face = top);

  connect elasticity.mechanical[boundary = left], clamp.mechanical;
  connect elasticity.mechanical[boundary = right], free_right.mechanical;
  connect elasticity.mechanical[boundary = bottom], free_bottom.mechanical;
  connect elasticity.mechanical[boundary = top], free_top.mechanical;
}
