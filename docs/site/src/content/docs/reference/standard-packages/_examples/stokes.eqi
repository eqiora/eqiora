import Eqiora.Fluid.Incompressible.incompressible as fluid;

model ReferenceStokes() {
  domain body = box(0, 4, 0, 1);
  domain left = boundary(body, axis = 0, side = lower);
  domain right = boundary(body, axis = 0, side = upper);
  domain bottom = boundary(body, axis = 1, side = lower);
  domain top = boundary(body, axis = 1, side = upper);
  variable velocity: vector<m / s, 2> on body in smooth;
  variable pressure: Pa on body in h1;
  parameter inlet_speed: m / s = 1;

  parameter viscosity: Pa * s = 1;
  instance flow: fluid.SteadyStokes2d(
    body = body,
    velocity = velocity, pressure = pressure,
    dynamic_viscosity = viscosity
  );
  relation inlet on left {
    trace(velocity) = -normal_vector() * inlet_speed;
  }
  relation outlet on right {
    normal(2 * viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)) = 0;
  }
  relation lower_wall on bottom { trace(velocity) = 0; }
  relation upper_wall on top { trace(velocity) = 0; }
}
