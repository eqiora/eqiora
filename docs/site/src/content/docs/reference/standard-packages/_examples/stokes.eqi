import Eqiora.Fluid.fluid as fluid;

model ReferenceStokes() {
  domain body = box(0, 4, 0, 1);
  domain left = boundary(body, axis = 0, side = lower);
  domain right = boundary(body, axis = 0, side = upper);
  domain bottom = boundary(body, axis = 1, side = lower);
  domain top = boundary(body, axis = 1, side = upper);
  variable velocity: vector<m / s, 2> on body in smooth;
  variable pressure: Pa on body in h1;
  parameter inlet_speed: m / s = 1;

  parameter viscosity: Pa * s = 1;
  instance flow: fluid.SteadyStokes2d(
    body = body, exterior = boundaries(left, right, bottom, top),
    velocity = velocity, pressure = pressure,
    dynamic_viscosity = viscosity
  );
  instance inlet: fluid.NormalVelocityInlet2d(
    body = body, face = left, speed = inlet_speed
  );
  instance outlet: fluid.TractionFree2d(body = body, face = right);
  instance lower_wall: fluid.NoSlip2d(body = body, face = bottom);
  instance upper_wall: fluid.NoSlip2d(body = body, face = top);
  connect flow.mechanical[boundary = left], inlet.mechanical;
  connect flow.mechanical[boundary = right], outlet.mechanical;
  connect flow.mechanical[boundary = bottom], lower_wall.mechanical;
  connect flow.mechanical[boundary = top], upper_wall.mechanical;
}
