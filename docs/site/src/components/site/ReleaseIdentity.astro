---
const RELEASE = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$/;

function fail(reason: string): never {
  throw new Error(`ReleaseIdentity: ${reason}`);
}

const propKeys = Object.keys(Astro.props);
if (propKeys.length > 0) {
  fail(`accepts no props, received \`${propKeys.join('`, `')}\``);
}
if (Object.keys(Astro.slots).length > 0 || Astro.slots.has('default')) {
  fail('accepts no default or named slot');
}

const cargoVersion = process.env.EQIORA_SITE_CARGO_VERSION;
if (typeof cargoVersion !== 'string') {
  fail('EQIORA_SITE_CARGO_VERSION must be supplied by the build process');
}
if (!RELEASE.test(cargoVersion)) {
  fail('EQIORA_SITE_CARGO_VERSION must be exactly `<major>.<minor>.<patch>`');
}

const pythonVersion = process.env.EQIORA_SITE_PYTHON_VERSION;
if (typeof pythonVersion !== 'string') {
  fail('EQIORA_SITE_PYTHON_VERSION must be supplied by the build process');
}
if (!RELEASE.test(pythonVersion)) {
  fail('EQIORA_SITE_PYTHON_VERSION must be exactly `<major>.<minor>.<patch>`');
}

if (cargoVersion !== pythonVersion) {
  fail('the Cargo and Python workspace versions must be identical');
}
---
<span>{pythonVersion}</span>
