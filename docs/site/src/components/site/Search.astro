---
import StarlightSearch from '@astrojs/starlight/components/Search.astro';
---

<StarlightSearch {...Astro.props} />

<script is:inline>
  for (const control of document.querySelectorAll('site-search button[data-open-modal]')) {
    const label = control.getAttribute('aria-label')?.trim();
    if (label) control.setAttribute('title', label);
  }

  const contentTypeFor = (value) => {
    const path = new URL(value, window.location.origin).pathname;
    if (path.startsWith('/learn/')) return 'Learn';
    if (path.startsWith('/guides/')) return 'Guide';
    if (path.startsWith('/gallery/')) return 'Gallery';
    if (path.startsWith('/reference/')) return 'Reference';
    if (path.startsWith('/get-started/')) return 'Get started';
    if (path.startsWith('/contributing/')) return 'Contributing';
    if (path.startsWith('/evidence/')) return 'Verification guide';
    return 'Eqiora';
  };

  const labelSearchResults = () => {
    for (const result of document.querySelectorAll('.pagefind-ui__result')) {
      if (result.querySelector('[data-eq-content-type]')) continue;
      const link = result.querySelector('.pagefind-ui__result-link[href]');
      if (!link) continue;
      let tags = result.querySelector('.pagefind-ui__result-tags');
      if (!tags) {
        tags = document.createElement('ul');
        tags.className = 'pagefind-ui__result-tags';
        result.querySelector('.pagefind-ui__result-inner')?.append(tags);
      }
      const tag = document.createElement('li');
      tag.className = 'pagefind-ui__result-tag';
      tag.dataset.eqContentType = '';
      tag.textContent = `Content type: ${contentTypeFor(link.href)}`;
      tags.append(tag);
    }
  };

  new MutationObserver(labelSearchResults).observe(document.documentElement, {
    childList: true,
    subtree: true,
  });
</script>
