// Shared interface contract: both subdomains expose velocity and traction.
public connector VelocityTractionBoundary {
  trace velocity: m / s;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

// Equations-only component for fluid-structure interaction on a fixed reference mesh.
// Python supplies the adjacent fluid and solid Geometry and binds these support names.
public component FixedReferenceFsi2d(
  support fluid: volume(ambient_dimension = 2),
  support fluid_x_lower: boundary(parent = fluid),
  support fluid_x_upper: boundary(parent = fluid),
  support fluid_y_lower: boundary(parent = fluid),
  support fluid_y_upper: boundary(parent = fluid),
  support solid: volume(ambient_dimension = 2),
  support solid_x_lower: boundary(parent = solid),
  support solid_x_upper: boundary(parent = solid),
  support solid_y_lower: boundary(parent = solid),
  support solid_y_upper: boundary(parent = solid),
  // Material properties and the reference pressure are compile-time Model inputs.
  parameter fluid_density: kg / m ^ 3,
  parameter fluid_viscosity: kg / (m * s),
  parameter solid_density: kg / m ^ 3,
  parameter solid_mu: kg / (m * s ^ 2),
  parameter solid_lambda: kg / (m * s ^ 2),
  parameter zero_pressure: kg / (m * s ^ 2)
) {
  // Each 2D volume owns four boundary roles; the touching pair becomes the interface.

  // Unknown continuum fields are scoped explicitly to the fluid or solid support.

  state fluid_velocity: vector<m / s, 2> on fluid in smooth;
  variable fluid_pressure: kg / (m * s ^ 2) on fluid in h1;
  variable fluid_load_potential: kg / (m * s ^ 2) on fluid;
  state solid_displacement: vector<m, 2> on solid in smooth;
  state solid_velocity: vector<m / s, 2> on solid in h1;
  variable solid_load_potential: kg / (m * s ^ 2) on solid;

  // Fluid: transient Stokes momentum balance with incompressibility.
  relation fluid_load_definition on fluid {
    fluid_load_potential - zero_pressure = 0;
  }
  relation fluid_momentum on fluid {
    fluid_density * derivative(fluid_velocity)
      - div(2 * fluid_viscosity * symmetric_part(grad(fluid_velocity))
        - isotropic_lift(fluid_pressure)) - grad(fluid_load_potential) = 0;
  }
  relation incompressibility on fluid { div(fluid_velocity) = 0; }

  // Solid: velocity is the displacement derivative, followed by momentum balance.
  relation solid_load_definition on solid {
    solid_load_potential - zero_pressure = 0;
  }
  relation solid_kinematics on solid {
    derivative(solid_displacement) - solid_velocity = 0;
  }
  relation solid_momentum on solid {
    solid_density * derivative(solid_velocity)
      - div(2 * solid_mu * symmetric_part(grad(solid_displacement))
        + solid_lambda * isotropic_lift(div(solid_displacement)))
      - grad(solid_load_potential) = 0;
  }

  // Homogeneous exterior velocity conditions leave the touching boundaries for coupling.
  relation fluid_x_lower_zero on fluid_x_lower { trace(fluid_velocity) = 0; }
  relation fluid_y_lower_zero on fluid_y_lower { trace(fluid_velocity) = 0; }
  relation fluid_y_upper_zero on fluid_y_upper { trace(fluid_velocity) = 0; }
  relation solid_x_upper_zero on solid_x_upper { trace(solid_velocity) = 0; }
  relation solid_y_lower_zero on solid_y_lower { trace(solid_velocity) = 0; }
  relation solid_y_upper_zero on solid_y_upper { trace(solid_velocity) = 0; }

  // The conserving connection enforces velocity continuity and balanced interface traction.
  port fluid_interface: VelocityTractionBoundary over fluid_x_upper;
  port solid_interface: VelocityTractionBoundary over solid_x_lower;
  relation fluid_interface_definition on fluid_x_upper {
    trace(fluid_velocity) - fluid_interface.velocity = 0;
    normal(2 * fluid_viscosity * symmetric_part(grad(fluid_velocity))
      - isotropic_lift(fluid_pressure)) - fluid_interface.traction = 0;
  }
  relation solid_interface_definition on solid_x_lower {
    trace(solid_velocity) - solid_interface.velocity = 0;
    normal(2 * solid_mu * symmetric_part(grad(solid_displacement))
      + solid_lambda * isotropic_lift(div(solid_displacement)))
      - solid_interface.traction = 0;
  }
  connect fluid_interface, solid_interface;
}
