import Eqiora.Scalar.scalar as scalar;

public component InversePoisson(
  support square: volume(ambient_dimension = 2),
  support x_lower: boundary(parent = square),
  support x_upper: boundary(parent = square),
  support y_lower: boundary(parent = square),
  support y_upper: boundary(parent = square),
  parameter diffusion: 1,
  parameter wave_number: 1 / m,
  parameter source_scale: 1 / m ^ 2,
  parameter boundary_offset: 1
) {

  variable potential: 1 on square in h1;
  instance balance: scalar.Poisson2d(
    body = square, potential = potential, coefficient = diffusion,
    source = source_scale * math.sin(wave_number * coordinate(0))
      * math.sin(wave_number * coordinate(1))
  );
  instance x_lower_value: scalar.FixedValue2d(
    body = square, face = x_lower, potential = potential, value = boundary_offset
  );
  instance x_upper_value: scalar.FixedValue2d(
    body = square, face = x_upper, potential = potential, value = boundary_offset
  );
  instance y_lower_value: scalar.FixedValue2d(
    body = square, face = y_lower, potential = potential, value = boundary_offset
  );
  instance y_upper_value: scalar.FixedValue2d(
    body = square, face = y_upper, potential = potential, value = boundary_offset
  );
}
