import Eqiora.Mechanics.Interfaces.interfaces as mechanics;

public component SteadyNewtonianBalance2d(
  support body: volume(ambient_dimension = 2),
  variable velocity: vector<m / s, 2> on body,
  variable pressure: kg / (m * s ^ 2) on body,
  variable force_potential: kg / (m * s ^ 2) on body,
  parameter dynamic_viscosity: kg / (m * s)
) {
  relation momentum on body {
    -div(
      2 * dynamic_viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)
    ) - grad(force_potential) = 0;
  }
  relation incompressibility on body {
    div(velocity) = 0;
  }
}

public component VelocityTractionInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable velocity: vector<m / s, 2> on body in smooth,
  variable pressure: kg / (m * s ^ 2) on body in h1,
  parameter dynamic_viscosity: kg / (m * s),
  port mechanical[boundary in exterior]: mechanics.VelocityTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(velocity)
      - mechanical[boundary = boundary].velocity = 0;
    normal(
      2 * dynamic_viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

public component SteadyStokes2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable velocity: vector<m / s, 2> on body in smooth,
  variable pressure: kg / (m * s ^ 2) on body in h1,
  variable force_potential: kg / (m * s ^ 2) on body,
  parameter dynamic_viscosity: kg / (m * s),
  port mechanical[boundary in exterior]: mechanics.VelocityTractionBoundary over boundary
) {
  instance balance: SteadyNewtonianBalance2d(
    body = body,
    velocity = velocity,
    pressure = pressure,
    force_potential = force_potential,
    dynamic_viscosity = dynamic_viscosity
  );
  instance interface: VelocityTractionInterface2d(
    body = body,
    exterior = exterior,
    velocity = velocity,
    pressure = pressure,
    dynamic_viscosity = dynamic_viscosity
  );

  connect [boundary in exterior]
    mechanical[boundary = boundary],
    interface.mechanical[boundary = boundary];
}

public component NoSlip2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: mechanics.VelocityTractionBoundary over face
) {
  relation prescribed_velocity on face {
    mechanical.velocity = 0;
  }
}

public component TractionFree2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: mechanics.VelocityTractionBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction = 0;
  }
}

public component NormalPressureOutlet2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable exterior_pressure: kg / (m * s ^ 2) on body in h1,
  port mechanical: mechanics.VelocityTractionBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction
      - normal(isotropic_lift(exterior_pressure)) = 0;
  }
}

public component NormalVelocityInlet2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable speed: m / s on body in h1,
  port mechanical: mechanics.VelocityTractionBoundary over face
) {
  relation prescribed_velocity on face {
    mechanical.velocity + normal(isotropic_lift(speed)) = 0;
  }
}

public component PrescribedVelocity2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable velocity: vector<m / s, 2> on body in h1,
  port mechanical: mechanics.VelocityTractionBoundary over face
) {
  relation prescribed_velocity on face {
    mechanical.velocity - trace(velocity) = 0;
  }
}

public component PrescribedTraction2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable traction: vector<kg / (m * s ^ 2), 2> on body in h1,
  port mechanical: mechanics.VelocityTractionBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction - trace(traction) = 0;
  }
}
