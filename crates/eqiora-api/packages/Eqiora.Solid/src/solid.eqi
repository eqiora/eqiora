public connector DisplacementTractionBoundary {
  trace displacement: m;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public property contract YoungModulus(): kg / (m * s ^ 2) { derivatives value_only; }

public property contract PoissonRatio(): 1 { derivatives value_only; }

public component IsotropicBalance2d(
  support body: volume(ambient_dimension = 2),
  variable displacement: vector<m, 2> on body,
  variable load_potential: kg / (m * s ^ 2) on body,
  parameter shear_modulus: kg / (m * s ^ 2),
  parameter first_lame_parameter: kg / (m * s ^ 2)
) {
  relation balance on body {
    -div(
      2 * shear_modulus * symmetric_part(grad(displacement))
      + first_lame_parameter * isotropic_lift(div(displacement))
    ) - grad(load_potential) = 0;
  }
}

public component DisplacementTractionInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  parameter shear_modulus: kg / (m * s ^ 2),
  parameter first_lame_parameter: kg / (m * s ^ 2),
  port mechanical[boundary in exterior]: DisplacementTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(displacement)
      - mechanical[boundary = boundary].displacement = 0;
    normal(
      2 * shear_modulus * symmetric_part(grad(displacement))
      + first_lame_parameter * isotropic_lift(div(displacement))
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

public component PlaneStrainLinearElasticity2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  variable load_potential: kg / (m * s ^ 2) on body,
  parameter young_modulus: kg / (m * s ^ 2),
  parameter poisson_ratio: 1,
  port mechanical[boundary in exterior]: DisplacementTractionBoundary over boundary
) {
  instance balance: IsotropicBalance2d(
    body = body,
    displacement = displacement,
    load_potential = load_potential,
    shear_modulus = young_modulus / (2 * (1 + poisson_ratio)),
    first_lame_parameter = young_modulus * poisson_ratio
      / ((1 + poisson_ratio) * (1 - 2 * poisson_ratio))
  );
  instance interface: DisplacementTractionInterface2d(
    body = body,
    exterior = exterior,
    displacement = displacement,
    shear_modulus = young_modulus / (2 * (1 + poisson_ratio)),
    first_lame_parameter = young_modulus * poisson_ratio
      / ((1 + poisson_ratio) * (1 - 2 * poisson_ratio))
  );

  connect [boundary in exterior]
    mechanical[boundary = boundary],
    interface.mechanical[boundary = boundary];
}

public component PlaneStressLinearElasticity2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  variable load_potential: kg / (m * s ^ 2) on body,
  parameter young_modulus: kg / (m * s ^ 2),
  parameter poisson_ratio: 1,
  port mechanical[boundary in exterior]: DisplacementTractionBoundary over boundary
) {
  instance balance: IsotropicBalance2d(
    body = body,
    displacement = displacement,
    load_potential = load_potential,
    shear_modulus = young_modulus / (2 * (1 + poisson_ratio)),
    first_lame_parameter = young_modulus * poisson_ratio
      / (1 - poisson_ratio ^ 2)
  );
  instance interface: DisplacementTractionInterface2d(
    body = body,
    exterior = exterior,
    displacement = displacement,
    shear_modulus = young_modulus / (2 * (1 + poisson_ratio)),
    first_lame_parameter = young_modulus * poisson_ratio
      / (1 - poisson_ratio ^ 2)
  );

  connect [boundary in exterior]
    mechanical[boundary = boundary],
    interface.mechanical[boundary = boundary];
}

public component PlaneStrainMaterial2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  variable load_potential: kg / (m * s ^ 2) on body,
  property young_modulus: YoungModulus,
  property poisson_ratio: PoissonRatio,
  port mechanical[boundary in exterior]: DisplacementTractionBoundary over boundary
) {
  instance elasticity: PlaneStrainLinearElasticity2d(
    body = body,
    exterior = exterior,
    displacement = displacement,
    load_potential = load_potential,
    young_modulus = young_modulus,
    poisson_ratio = poisson_ratio
  );
  connect [boundary in exterior]
    mechanical[boundary = boundary],
    elasticity.mechanical[boundary = boundary];
}

public component PlaneStressMaterial2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  variable load_potential: kg / (m * s ^ 2) on body,
  property young_modulus: YoungModulus,
  property poisson_ratio: PoissonRatio,
  port mechanical[boundary in exterior]: DisplacementTractionBoundary over boundary
) {
  instance elasticity: PlaneStressLinearElasticity2d(
    body = body,
    exterior = exterior,
    displacement = displacement,
    load_potential = load_potential,
    young_modulus = young_modulus,
    poisson_ratio = poisson_ratio
  );
  connect [boundary in exterior]
    mechanical[boundary = boundary],
    elasticity.mechanical[boundary = boundary];
}

public component FixedDisplacement2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: DisplacementTractionBoundary over face
) {
  relation prescribed_displacement on face {
    mechanical.displacement = 0;
  }
}

public component TractionFree2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: DisplacementTractionBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction = 0;
  }
}

public component PrescribedDisplacement2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable displacement: vector<m, 2> on body in h1,
  port mechanical: DisplacementTractionBoundary over face
) {
  relation prescribed_displacement on face {
    mechanical.displacement - trace(displacement) = 0;
  }
}

public component PrescribedTraction2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  variable traction: vector<kg / (m * s ^ 2), 2> on body in h1,
  port mechanical: DisplacementTractionBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction - trace(traction) = 0;
  }
}
