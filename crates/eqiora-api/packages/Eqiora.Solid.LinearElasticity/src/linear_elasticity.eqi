import Eqiora.Mechanics.Interfaces.interfaces as mechanics;

public component IsotropicBalanceWithPotential2d(
  support body: volume(ambient_dimension = 2),
  variable displacement: vector<m, 2> on body,
  variable load_potential: kg / (m * s ^ 2) on body,
  parameter mu: kg / (m * s ^ 2),
  parameter lambda: kg / (m * s ^ 2)
) {
  relation balance on body {
    -div(
      2 * mu * symmetric_part(grad(displacement))
      + lambda * isotropic_lift(div(displacement))
    ) - grad(load_potential) = 0;
  }
}

public connector QuasistaticMechanicalBoundary {
  trace displacement: m;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public component IsotropicMechanicalInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  parameter mu: kg / (m * s ^ 2),
  parameter lambda: kg / (m * s ^ 2),
  port mechanical[boundary in exterior]: QuasistaticMechanicalBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(displacement)
      - mechanical[boundary = boundary].displacement = 0;
    normal(
      2 * mu * symmetric_part(grad(displacement))
      + lambda * isotropic_lift(div(displacement))
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

public component FixedDisplacement2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: QuasistaticMechanicalBoundary over face
) {
  relation prescribed_displacement on face {
    mechanical.displacement = 0;
  }
}

public component ZeroTraction2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: QuasistaticMechanicalBoundary over face
) {
  relation prescribed_traction on face {
    mechanical.traction = 0;
  }
}

public component IsotropicElastodynamicsWithPotential2d(
  support body: volume(ambient_dimension = 2),
  state displacement: vector<m, 2> on body,
  state velocity: vector<m / s, 2> on body,
  variable load_potential: kg / (m * s ^ 2) on body,
  parameter density: kg / m ^ 3,
  parameter mu: kg / (m * s ^ 2),
  parameter lambda: kg / (m * s ^ 2)
) {
  relation kinematics on body {
    derivative(displacement) - velocity = 0;
  }
  relation momentum on body {
    density * derivative(velocity)
      - div(
        2 * mu * symmetric_part(grad(displacement))
        + lambda * isotropic_lift(div(displacement))
      )
      - grad(load_potential) = 0;
  }
}

public component ElastodynamicMechanicalInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable displacement: vector<m, 2> on body in smooth,
  variable velocity: vector<m / s, 2> on body in h1,
  parameter mu: kg / (m * s ^ 2),
  parameter lambda: kg / (m * s ^ 2),
  port mechanical[boundary in exterior]: mechanics.VelocityTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(velocity)
      - mechanical[boundary = boundary].velocity = 0;
    normal(
      2 * mu * symmetric_part(grad(displacement))
      + lambda * isotropic_lift(div(displacement))
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

