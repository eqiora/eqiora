import Eqiora.Mechanics.Interfaces.interfaces as mechanics;

public operator outer_product(
  input left: spatial[1], input right: spatial[1]
): spatial[2]
  = component(left, 0) * component(right, 1);

public component SteadyStokesWithPotential2d(
  support body: volume(ambient_dimension = 2),
  variable velocity: vector<m / s, 2> on body,
  variable pressure: kg / (m * s ^ 2) on body,
  variable force_potential: kg / (m * s ^ 2) on body,
  parameter dynamic_viscosity: kg / (m * s)
) {
  relation momentum on body {
    -div(
      2 * dynamic_viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)
    ) - grad(force_potential) = 0;
  }
  relation incompressibility on body {
    div(velocity) = 0;
  }
}

public component NewtonianMechanicalInterface2d(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  variable velocity: vector<m / s, 2> on body in smooth,
  variable pressure: kg / (m * s ^ 2) on body in h1,
  parameter dynamic_viscosity: kg / (m * s),
  port mechanical[boundary in exterior]: mechanics.VelocityTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(velocity)
      - mechanical[boundary = boundary].velocity = 0;
    normal(
      2 * dynamic_viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)
    ) - mechanical[boundary = boundary].traction = 0;
  }
}

public component ConservativeNavierStokesWithPotential3d(
  support body: volume(ambient_dimension = 3),
  state velocity: vector<m / s, 3> on body,
  variable pressure: kg / (m * s ^ 2) on body,
  variable force_potential: kg / (m * s ^ 2) on body,
  parameter density: kg / m ^ 3,
  parameter dynamic_viscosity: kg / (m * s)
) {
  relation momentum on body {
    density * derivative(velocity)
      + div(density * outer_product(left = velocity, right = velocity))
      - div(
        2 * dynamic_viscosity * symmetric_part(grad(velocity))
        - isotropic_lift(pressure)
      )
      - grad(force_potential) = 0;
  }
  relation incompressibility on body {
    div(velocity) = 0;
  }
}

public component NewtonianMechanicalInterface3d(
  support body: volume(ambient_dimension = 3),
  support exterior: complete_exterior(parent = body),
  variable velocity: vector<m / s, 3> on body in smooth,
  variable pressure: kg / (m * s ^ 2) on body in h1,
  parameter dynamic_viscosity: kg / (m * s),
  port mechanical[boundary in exterior]: mechanics.VelocityTractionBoundary over boundary
) {
  relation boundary_interface[boundary in exterior] on boundary {
    trace(velocity)
      - mechanical[boundary = boundary].velocity = 0;
    normal(
      2 * dynamic_viscosity * symmetric_part(grad(velocity))
      - isotropic_lift(pressure)
    ) - mechanical[boundary = boundary].traction = 0;
  }
}
