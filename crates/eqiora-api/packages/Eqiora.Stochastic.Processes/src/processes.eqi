/// A dimensionless mean-reverting state driven by additive Wiener noise.
public component OrnsteinUhlenbeck(
  parameter initial_value: 1,
  parameter mean: 1,
  parameter reversion_rate: 1 / s,
  parameter volatility: 1 / s ^ (1/2)
) {
  noise driving: wiener(covariance = 1, independent = true);
  state value: 1;
  observable sample: 1 = value;
  initial { value = initial_value; }
  law evolution for value {
    calculus ito;
    drift reversion_rate * (mean - value);
    diffusion driving = volatility;
  }
}

/// A dimensionless state driven by multiplicative Wiener noise in Ito calculus.
public component GeometricBrownianMotion(
  parameter initial_value: 1,
  parameter growth_rate: 1 / s,
  parameter volatility: 1 / s ^ (1/2)
) {
  noise driving: wiener(covariance = 1, independent = true);
  state value: 1;
  observable sample: 1 = value;
  initial { value = initial_value; }
  law evolution for value {
    calculus ito;
    drift growth_rate * value;
    diffusion driving = volatility * value;
  }
}
