public component PoissonCube(
  support cube: volume(ambient_dimension = 3),
  support x_lower: boundary(parent = cube),
  support x_upper: boundary(parent = cube),
  support y_lower: boundary(parent = cube),
  support y_upper: boundary(parent = cube),
  support z_lower: boundary(parent = cube),
  support z_upper: boundary(parent = cube),
  parameter diffusion: 1,
  parameter wave_number: 1 / m,
  parameter source_scale: 1 / m ^ 2,
  parameter boundary_offset: 1
) {
  variable potential: 1 on cube in h1;
  relation balance on cube {
    -div(diffusion * grad(potential)) = source_scale
      * math.sin(wave_number * coordinate(0))
      * math.sin(wave_number * coordinate(1))
      * math.sin(wave_number * coordinate(2));
  }
  relation x_lower_value on x_lower { trace(potential) = boundary_offset; }
  relation x_upper_value on x_upper { trace(potential) = boundary_offset; }
  relation y_lower_value on y_lower { trace(potential) = boundary_offset; }
  relation y_upper_value on y_upper { trace(potential) = boundary_offset; }
  relation z_lower_value on z_lower { trace(potential) = boundary_offset; }
  relation z_upper_value on z_upper { trace(potential) = boundary_offset; }
}
