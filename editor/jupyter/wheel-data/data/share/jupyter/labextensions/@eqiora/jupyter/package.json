{
  "name": "@eqiora/jupyter",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "typecheck": "node prepare.mjs && tsc --noEmit",
    "build": "node prepare.mjs && tsc && jupyter labextension build .",
    "test": "playwright test",
    "dev": "node prepare.mjs && vite --host 127.0.0.1 --port 18926",
    "example": "python3 example.py",
    "prepare": "node prepare.mjs",
    "test:host": "playwright test --config host.config.ts"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "wheel-data/data/share/jupyter/labextensions/@eqiora/jupyter",
    "_build": {
      "load": "static/remoteEntry.317e200e5f1a27563dd2.js",
      "extension": "./extension"
    }
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@jupyterlab/application": "4.5.11",
    "@jupyterlab/codemirror": "4.5.11",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/vscode-textmate": "10.0.2",
    "@lezer/highlight": "1.2.3"
  },
  "devDependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@jupyterlab/builder": "4.5.11",
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1"
  }
}
