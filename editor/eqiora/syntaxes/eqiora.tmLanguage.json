{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "eqiora",
  "scopeName": "source.eqiora",
  "fileTypes": ["eqi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#units" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.eqiora", "match": "//.*$" }] },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": { "1": { "name": "keyword.declaration.eqiora" }, "2": { "name": "entity.name.namespace.eqiora" } }
        },
        {
          "match": "\\b(?:(public|private)\\s+)?(?:(property)\\s+(contract|release)|(material)\\s+(composition)|(pure)\\s+(operator)|(component|connector|model|dimension|enum|record|indexset|space))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.eqiora" }, "2": { "name": "keyword.declaration.eqiora" },
            "3": { "name": "keyword.declaration.eqiora" }, "4": { "name": "keyword.declaration.eqiora" },
            "5": { "name": "keyword.declaration.eqiora" }, "6": { "name": "keyword.declaration.eqiora" },
            "7": { "name": "keyword.declaration.eqiora" }, "8": { "name": "keyword.declaration.eqiora" },
            "9": { "name": "entity.name.type.eqiora" }
          }
        },
        {
          "match": "\\b(variable|state|parameter|observable|support|port|relation|law|instance|domain|clock|event|let|form)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.eqiora" }, "2": { "name": "variable.other.definition.eqiora" } }
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.eqiora", "match": "\\b(?:array|complex|tensor|vector)\\b(?=\\s*<)" },
        { "name": "support.type.eqiora", "match": "\\b(?:bool|integer)\\b" }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.eqiora",
        "match": "\\b(?:across|ambient_dimension|analytic|as|at|axis|boundaries|boundary|branch|case|citation|clock|complete_exterior|component|components|composition|connect|connector|contract|crossing|data|delta|derivatives|dimension|direction|discrete|domain|else|endpoint_derivative|enum|event|field|first_open_intervals|first_partials|flux(?!\\s*\\()|for|form|frame|holding|identity|if|implements|import|in|initial|input|instance|interpolation|knot_derivative|law|license|let|lower|material|missing|model|observable|on|operator|orientation|outside|output|over|pairing|parameter|parent|period|periodic|phase|piecewise_affine|port|preprocessing|private|property|public|pure|rational|record|reject|relation|release|scalar|shape|side|signal|source_unit|spatial|state|support|table|test|then|through|trace(?!\\s*\\()|unconditional|upper|validity|value|value_only|variable|volume|wrt|zero_on)\\b"
      }]
    },
    "functions": {
      "patterns": [{
        "name": "support.function.eqiora",
        "match": "\\b(?:boundary|boundaries|box|complementarity|component|coordinate|crossing|derivative|div|dot|grad|inclusion|inequality|integral|isotropic_lift|measure|normal|orthonormal|partial|product|range|sum|scalar_physical|symmetric_part|tensor_value|trace|volume)\\b(?=\\s*\\()"
      }]
    },
    "constants": {
      "patterns": [{
        "name": "constant.language.eqiora",
        "match": "\\b(?:any|euclidean_boundary_duality|falling|false|invariant|parent_outward|rising|spatial_scalar|spatial_vector|true)\\b"
      }]
    },
    "units": {
      "patterns": [{ "name": "support.type.unit.eqiora", "match": "\\b(?:kg|m|s|A|K|mol|cd|Hz|N|Pa|J|W)\\b" }]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.eqiora", "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?" }]
    },
    "operators": { "patterns": [{ "name": "keyword.operator.eqiora", "match": "\\b(?:and|not|or)\\b|->|=>|==|!=|<=|>=|[<>=+\\-*/^]" }] },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.eqiora", "match": "[{}()\\[\\]]" },
        { "name": "punctuation.separator.eqiora", "match": "[;,:.]" }
      ]
    }
  }
}
